{
  "name": "fleetflow-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FleetFlow Manager / Admin web dashboard (React + Vite + TypeScript SPA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.3",
    "@sentry/react": "^8.55.2",
    "@tanstack/react-query": "^5.59.16",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
