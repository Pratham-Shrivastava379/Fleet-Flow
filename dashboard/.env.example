# FleetFlow dashboard (Phase 11)
# Map provider (product decision: OpenStreetMap is ACTIVE, Google Maps is
# DORMANT until further notice). Values:
#   osm        (default) OpenStreetMap raster tiles via Leaflet — no key needed.
#   schematic  deterministic offline SVG map (no network).
#   google     DORMANT path — only activates together with
#              VITE_GOOGLE_MAPS_API_KEY below. Leaving this unset keeps Google
#              Maps inert even if a key is present.
VITE_MAP_PROVIDER=osm

# Google Maps JS API key. DORMANT — only consumed when VITE_MAP_PROVIDER=google
# is ALSO set; the key alone never re-enables the Google path.
VITE_GOOGLE_MAPS_API_KEY=

# Phase 13: Sentry error tracking. OPTIONAL —
# when absent the app is byte-identical (no init, no network). Build-time
# value: set in .env / CI, NEVER commit a real DSN.
VITE_SENTRY_DSN=
# Optional trace sample rate for the web surface (default 0.1 when DSN set).
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
