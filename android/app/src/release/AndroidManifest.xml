<?xml version="1.0" encoding="utf-8"?>
<!--
    Release overlay (Phase 15 hardening, blueprint §5.6): the debug manifest sets
    android:usesCleartextTraffic="true" for the local dev backend (10.0.2.2).
    Release builds MUST NOT allow cleartext — production API is HTTPS-only. The
    merger replaces the main manifest's value with false in release builds only;
    debug builds keep cleartext for the emulator.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic" />
</manifest>