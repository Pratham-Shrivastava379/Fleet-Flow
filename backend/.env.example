# FleetFlow backend — copy to .env and fill in real values.
# Never commit the real .env. In production, inject via secrets manager (see blueprint §11/§13).

# PostgreSQL (Phase 1+) with PostGIS. Local dev via docker-compose at repo root.
DATABASE_URL="postgresql://fleetflow:fleetflow@localhost:5432/fleetflow?schema=public"

# JWT secrets — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

PORT=3000
NODE_ENV=development

# Global per-IP rate limit (Phase 4/15, blueprint §4.2): max requests per minute
# across all /api routes. 300 is the MVP default — generous per single device,
# but raise it (e.g. RATE_LIMIT_GLOBAL_MAX=20000) for capacity/load-test runs or
# a fleet behind one egress NAT. Auth routes keep their own stricter limit.
RATE_LIMIT_GLOBAL_MAX=300

# Redis (Phase 4+: rate limiting, pub/sub, BullMQ). Optional until Phase 4.
REDIS_URL="redis://localhost:6379"

# Phase 11 - web dashboard (browser SPA):
# Refresh token for web clients is delivered as an HttpOnly SameSite=Strict cookie
# (never the JSON body, never localStorage). Secure flag auto-on in production.
WEB_REFRESH_COOKIE="fleetflow_refresh"
WEB_REFRESH_COOKIE_SECURE=false
# CORS allow-list (comma-separated) for the browser client (blueprint 5.6).
# Vite dev proxies /api + /ws same-origin, so this mainly matters for direct cross-origin use.
CORS_ORIGINS="http://localhost:5173"

# Push notifications (FCM). Provide one of:
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# FCM_SERVICE_ACCOUNT_JSON={...full service-account json...}

# SOS SMS fallback (Twilio). Off by default; the system functions without it.
SMS_SOS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_SOS_TO=
APP_BASE_URL=http://localhost:3000

# Phase 10 - stale-trip reaper (runs with the nightly retention job): ACTIVE trips with no ping
# for this many hours are auto-cancelled. 0 disables.
STALE_TRIP_HOURS=12

# Phase 10 - on-device offline-queue hard cap (§3.6). Once the Android client's queued-ping
# table exceeds this, it downsamples oldest stationary points (keep every 3rd). The backend
# carries the same number so client/server defaults stay in parity.
PING_QUEUE_HARD_CAP=5000

# Phase 13 - observability (blueprint §11):
# Structured JSON logging level (pino). "silent" disables all app logs.
LOG_LEVEL=info
# §5 token delivery: reset/invite tokens are secrets. In development, set
# DEV_TOKEN_DELIVERY=true to opt into the structured-log/sink delivery channel
# (e.g. so you can complete a forgot-password flow locally). It is ALWAYS
# refused in production (the app fails to boot with it set there) — production
# delivery requires a real email provider (Phase 7+).
DEV_TOKEN_DELIVERY=
# Prometheus /api/metrics (API) + worker exporter (:9091) bearer token. When set,
# scrapes must present it as `Authorization: Bearer <token>` (§4.2: not public).
# Leave empty for local dev without auth.
METRICS_TOKEN=
# Worker-process Prometheus exporter port (geofence-eval/notification latency + queue
# depth live in the worker process, which has no HTTP server of its own).
WORKER_METRICS_PORT=9091
# Sentry error tracking (backend). Inert until a DSN is set (stub-until-configured,
# same convention as FCM/SMS). Optional: SENTRY_TRACES_SAMPLE_RATE (0.0 = errors only).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# OpenTelemetry tracing. Enabled automatically when an OTLP/HTTP collector endpoint
# is set (the local compose stack runs Jaeger at http://jaeger:4318). Disable explicitly
# with OTEL_ENABLED=false.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fleetflow-backend
# sdk-node >= 0.222 auto-enables an OTLP METRICS reader when an OTLP endpoint is
# set. Our metrics go to Prometheus via /api/metrics + the worker exporter, so
# keep OTLP traces-only with OTEL_METRICS_EXPORTER=none (Jaeger has no /v1/metrics).
OTEL_METRICS_EXPORTER=none

