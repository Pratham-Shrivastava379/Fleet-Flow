# Test-process environment (loaded by the npm test script via --env-file).
# Silences the Phase 13 structured request/job logs during the suite so node:test
# output stays readable; individual failures still surface via assertions.
# Already-present shell env vars win over this file (node --env-file does not
# override existing vars), so LOG_LEVEL=info npm test debugs request logs live.
LOG_LEVEL=silent
# Tracing must never initialize inside test processes (no collector, and
# instrumentation ordering vs. express imports is an entrypoint concern).
OTEL_ENABLED=false
# §5: tests capture reset/invite tokens through the dev sink — explicitly
# opt-in, development/test-only (production refuses this channel; see
# authService.tokenDeliveryPolicy + config fail-fast).
DEV_TOKEN_DELIVERY=true
