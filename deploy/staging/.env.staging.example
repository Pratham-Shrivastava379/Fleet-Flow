# FleetFlow staging environment (Phase 14, §13.4). Copy to .env.staging on the
# staging host (git-ignored in spirit — it holds secrets) and fill in real
# values. deploy.sh loads it via --env-file when present; IMAGE_TAG is always
# passed explicitly by the CD workflow (the git SHA).
#
# --- Deployed image (IMAGE_TAG comes from the CD workflow, not this file) ---
# REGISTRY=ghcr.io/your-org/fleetflow
# IMAGE_TAG=<set by CD>

# --- Postgres / Redis (credentials for the stack's own containers) ---
# POSTGRES_USER=fleetflow
# POSTGRES_PASSWORD=<long random>
# POSTGRES_DB=fleetflow
# Host ports (leave default unless another service occupies them):
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# --- API / worker ---
# JWT secrets MUST NOT contain "dev-" (config.js production guard). Rotate via
# your secrets manager; a shared secret between api+worker is fine here because
# the stack is one trust domain (both containers get the same env).
# JWT_ACCESS_SECRET=<long random>
# JWT_REFRESH_SECRET=<long random>
# WEB_REFRESH_COOKIE_SECURE=true
# CORS_ORIGINS=https://fleet.example.com
# LOG_LEVEL=info
# METRICS_TOKEN=<long random>          # blank = /api/metrics unauthenticated
# SENTRY_DSN=                          # optional
# API_PORT=3000
# WORKER_METRICS_HOST_PORT=9091
# WORKER_METRICS_PORT=9091
